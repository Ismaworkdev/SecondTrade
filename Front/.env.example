# SecondTrade Frontend - Variables de Entorno
# Copia este archivo como .env y configura las variables según tu entorno

# URL de la API Backend
# Para desarrollo local:
VITE_API_URL=http://localhost:8000

# Para producción (cambiar por la URL real de tu API):
# VITE_API_URL=https://tu-api.com

# Nombre de la aplicación
VITE_APP_NAME=SecondTrade

# Versión de la aplicación
VITE_APP_VERSION=1.0.0

# Entorno de ejecución
# Valores posibles: development, production, test
VITE_NODE_ENV=development

# Configuración de mapas (opcional)
# Si usas servicios de mapas como OpenStreetMap, Mapbox, etc.
# VITE_MAP_API_KEY=tu_clave_api_de_mapas

# Configuración de análitica (opcional)
# VITE_GOOGLE_ANALYTICS_ID=tu_id_de_google_analytics

# Debug mode (opcional)
# Habilita logs adicionales en desarrollo
VITE_DEBUG=true

